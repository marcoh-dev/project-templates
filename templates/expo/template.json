{
	"description": "Expo (React Native) app with TypeScript, code in src/",
	"create": "pnpm create expo-app@latest {name} --template blank-typescript",
	"removeFiles": ["App.tsx", "index.ts"],
	"devDependencies": ["eslint@^9", "eslint-config-expo", "prettier", "eslint-config-prettier"],
	"installCommand": "pnpm expo install {packages} -- --save-dev",
	"moveToDevDependencies": ["eslint", "eslint-config-expo", "prettier", "eslint-config-prettier"],
	"package": {
		"main": "src/index.ts",
		"engines": { "node": "24.x" },
		"scripts": {
			"lint": "expo lint",
			"lint:fix": "expo lint --fix",
			"format": "prettier --write .",
			"format:check": "prettier --check .",
			"typecheck": "tsc --noEmit",
			"check": "pnpm lint && pnpm format:check && pnpm typecheck",
			"doctor": "npm_config_force=true pnpm dlx expo-doctor",
			"sync": "git switch main && git pull && pnpm install",
			"sync:branch": "git fetch origin && git merge --no-commit origin/main && pnpm install"
		}
	}
}
